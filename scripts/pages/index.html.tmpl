<!doctype html>
<!-- Generated by scripts/build-pages.py. Edit scripts/pages/ instead. -->
<html lang="$lang">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>$title | Codex Limit Tray</title>
  <meta name="description" content="$description">
  <meta property="og:type" content="website">
  <meta property="og:title" content="$title | Codex Limit Tray">
  <meta property="og:description" content="$description">
  <meta property="og:image" content="${site}images/tray-modes.en.png">
  <link rel="canonical" href="$canonical">
$alternates
  <link rel="icon" href="${assets}tray.svg" type="image/svg+xml">
  <link rel="stylesheet" href="${assets}pages.css">
</head>
<body>
  <header class="site-header wrap">
    <a class="brand" href="./"><img src="${assets}tray.svg" width="30" height="30" alt="">Codex Limit Tray</a>
    <details class="languages">
      <summary aria-label="$language_label: $locale_name">$locale_name</summary>
      <nav aria-label="$language_label">
        <ul>
$language_links
        </ul>
      </nav>
    </details>
  </header>

  <main>
    <section class="hero">
      <div class="wrap hero-layout">
        <div>
          <p class="eyebrow">$eyebrow</p>
          <h1>$title</h1>
          <p class="intro">$description</p>
          <div class="actions">
            <a class="button" href="$download_url">$download <span aria-hidden="true">↓</span></a>
            <a href="${repository}/releases">$releases</a>
          </div>
          <p class="requirement">$requirement</p>
        </div>
        <figure class="tray-preview">
          <a href="${assets}images/tray-modes.en.png">
            <img src="${assets}images/tray-modes.en.png" width="1840" height="620" fetchpriority="high" alt="$tray_alt">
          </a>
          <figcaption>$tray_caption</figcaption>
        </figure>
      </div>
    </section>

    <section class="setup wrap" aria-labelledby="setup-title">
      <div>
        <p class="eyebrow">$setup</p>
        <h2 id="setup-title">$setup_title</h2>
        <ol class="steps">
          <li><strong>$signin_title</strong> $signin_before <code>codex login</code>$signin_after</li>
          <li><strong>$install_title</strong> $install_body</li>
          <li><strong>$open_title</strong> $open_body</li>
        </ol>
        <aside class="tip">
          <h3>$tip_title</h3>
          <p>$tip_body</p>
        </aside>
      </div>
      <figure class="app-preview">
        <a href="${assets}images/main-dark.en.png">
          <img src="${assets}images/main-dark.en.png" width="420" height="600" loading="lazy" alt="$dashboard_alt">
        </a>
        <figcaption>$dashboard_caption</figcaption>
      </figure>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>$disclaimer</p>
      <a href="$repository">$source_link</a>
    </div>
  </footer>
</body>
</html>
